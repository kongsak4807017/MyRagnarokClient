<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <Button android:id="@id/button_respawn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Return to last save point" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:layout_alignParentRight="true" />
    <Button android:id="@id/button_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Return to game" android:layout_below="@id/button_respawn" android:layout_alignParentLeft="true" android:layout_alignParentRight="true" />
    <Button android:id="@id/button_resurrect" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resurrect" android:layout_below="@id/button_cancel" android:layout_alignParentLeft="true" android:layout_alignParentRight="true" />
</RelativeLayout>
